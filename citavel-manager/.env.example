APP_URL=http://localhost:3002
PORT=3002
DATABASE_URL=postgresql://citavel:SET_A_RANDOM_PASSWORD@127.0.0.1:55432/citavel_manager
POSTGRES_PASSWORD=SET_A_RANDOM_PASSWORD
SEED_ADMIN_EMAIL=admin@citavel.local
SEED_ADMIN_PASSWORD=SET_A_UNIQUE_RANDOM_PASSWORD
SESSION_SECRET=SET_A_RANDOM_SECRET
CITAVEL_ENGINE_PATH=/Users/pedro/Documents/CITAVEL/citavel-engine
CITAVEL_ENGINE_URL=http://localhost:8788
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_MODE=DISABLED
N8N_WEBHOOK_URL=http://localhost:5678/webhook/citavel-manager-run
N8N_STATUS_URL=http://localhost:5678/webhook/citavel-manager-status
N8N_WEBHOOK_SECRET=
ENGINE_EVENT_SECRET=SET_A_DIFFERENT_RANDOM_SECRET
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact OAuth redirect URI registered in Google Cloud (https in production; http allowed only for localhost)
GOOGLE_REDIRECT_URI=http://localhost:3002/api/integrations/google/callback
# 32+ chars; encrypts Google refresh tokens at rest (falls back to a key derived from SESSION_SECRET)
GOOGLE_TOKEN_KEY=
# 32+ chars; shared only with the n8n scheduler (header X-Citavel-Job-Secret). Never a Google token.
GSC_JOB_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
DOCKER_BIN=/Applications/Docker.app/Contents/Resources/bin/docker
N8N_CONTAINER=n8n
SYNC_INTERVAL_MS=600000
